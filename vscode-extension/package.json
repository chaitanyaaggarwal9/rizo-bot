{
  "name": "rizo",
  "displayName": "Rizo",
  "description": "BYOK AI coding assistant — cost-optimized model routing, file edit, terminal, git, all through your own OpenRouter key.",
  "version": "0.4.0",
  "publisher": "ChaitanyaAggarwal",
  "icon": "icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaitanyaaggarwal9/rizo-bot.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/chaitanyaaggarwal9/rizo-bot/issues"
  },
  "homepage": "https://github.com/chaitanyaaggarwal9/rizo-bot/blob/main/vscode-extension/ONBOARDING.md",
  "keywords": ["ai", "chat", "assistant", "openrouter", "byok", "coding assistant"],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Chat"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rizo.openChat",
        "title": "Rizo: Open Chat"
      }
    ],
    "configuration": {
      "title": "Rizo",
      "properties": {
        "rizo.permissions.autoApproveCommandPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "Regex patterns tested against the full `run_command` string. A match skips the approval dialog entirely. **Has no effect on destructive commands** (force-push, `reset --hard`, `branch -D`, `rm -rf`, etc.) — those always ask, regardless of this setting."
        },
        "rizo.permissions.disabledTools": {
          "type": "array",
          "items": { "type": "string", "enum": ["read_file", "write_file", "edit_file", "run_command"] },
          "default": [],
          "description": "Tools listed here are refused outright and not offered to the model at all in this workspace."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.2.0"
  }
}
