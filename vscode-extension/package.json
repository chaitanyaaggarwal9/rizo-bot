  },
  "bugs": {
    "url": "https://github.com/chaitanyaaggarwal9/rizo-bot/issues"
  },
  "homepage": "https://github.com/chaitanyaaggarwal9/rizo-bot/blob/main/vscode-extension/ONBOARDING.md",
