{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rizo Lang",
  "scopeName": "source.rizolang",
  "fileTypes": [
    "rz"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#body"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.rizolang",
      "match": "//.*$"
    },
    "declaration": {
      "patterns": [
        {
          "match": "^\\s*(model)\\s+([A-Za-z][A-Za-z0-9]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.model.rizolang"
            },
            "2": {
              "name": "entity.name.type.model.rizolang"
            }
          }
        },
        {
          "match": "^\\s*(auth)\\s+([A-Za-z][A-Za-z0-9]*)\\s+(by)\\s+([a-z][A-Za-z0-9]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.auth.rizolang"
            },
            "2": {
              "name": "entity.name.type.model.rizolang"
            },
            "3": {
              "name": "keyword.other.rizolang"
            },
            "4": {
              "name": "variable.other.property.rizolang"
            }
          }
        },
        {
          "match": "^\\s*(privacy)\\s+(for)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.privacy.rizolang"
            },
            "2": {
              "name": "keyword.other.rizolang"
            }
          }
        },
        {
          "match": "^\\s*(api)\\s+(GET|POST|PUT|PATCH|DELETE)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.api.rizolang"
            },
            "2": {
              "name": "support.constant.http-method.rizolang"
            }
          }
        },
        {
          "match": "^\\s*(page)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.page.rizolang"
            }
          }
        },
        {
          "match": "^\\s*([a-z][A-Za-z0-9]*)\\s*(:)(?=\\s)",
          "captures": {
            "1": {
              "name": "variable.other.property.rizolang"
            },
            "2": {
              "name": "punctuation.separator.key-value.rizolang"
            }
          }
        }
      ]
    },
    "body": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "name": "string.quoted.double.rizolang",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.rizolang",
              "match": "\\\\."
            }
          ]
        },
        {
          "match": "\\b(db)(\\.)([A-Z][A-Za-z0-9]*)(\\.)(find|list|create|update|delete)\\b",
          "captures": {
            "1": {
              "name": "variable.language.db.rizolang"
            },
            "2": {
              "name": "punctuation.accessor.rizolang"
            },
            "3": {
              "name": "entity.name.type.model.rizolang"
            },
            "4": {
              "name": "punctuation.accessor.rizolang"
            },
            "5": {
              "name": "support.function.rizolang"
            }
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9]*)(\\.)(public)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.model.rizolang"
            },
            "2": {
              "name": "punctuation.accessor.rizolang"
            },
            "3": {
              "name": "storage.modifier.rizolang"
            }
          }
        },
        {
          "name": "support.type.primitive.rizolang",
          "match": "\\b(Text|Number|Bool|Email|Password|Date|ID)\\b"
        },
        {
          "name": "storage.modifier.rizolang",
          "match": "\\b(unique|optional|private|encrypted|min|max)\\b"
        },
        {
          "name": "keyword.control.access.rizolang",
          "match": "\\b(public|requires|login|role|roles|owner|or)\\b"
        },
        {
          "name": "keyword.control.rizolang",
          "match": "\\b(return|then|go)\\b"
        },
        {
          "name": "keyword.other.page.rizolang",
          "match": "\\b(title|text|link|show|form|button)\\b"
        },
        {
          "name": "keyword.other.rizolang",
          "match": "\\b(list|with|order|desc|limit|per|keep|contains|by|for|body)\\b"
        },
        {
          "name": "keyword.other.unit.rizolang",
          "match": "\\b(seconds?|minutes?|hours?|days?|months?|years?)\\b"
        },
        {
          "name": "support.constant.http-method.rizolang",
          "match": "\\b(GET|POST|PUT|PATCH|DELETE)\\b"
        },
        {
          "name": "constant.other.region.rizolang",
          "match": "\\b(EU|UK|IN|US-CA|BR)\\b"
        },
        {
          "name": "variable.language.me.rizolang",
          "match": "\\bme\\b"
        },
        {
          "name": "constant.language.boolean.rizolang",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.rizolang",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "variable.parameter.query.rizolang",
          "match": "\\?[a-z][A-Za-z0-9]*"
        },
        {
          "match": "(/)((?:[a-z0-9_-]+|:[a-z][A-Za-z0-9]*)(?:/(?:[a-z0-9_-]+|:[a-z][A-Za-z0-9]*))*)?/?",
          "name": "string.unquoted.path.rizolang",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "variable.parameter.path.rizolang",
                  "match": ":[a-z][A-Za-z0-9]*"
                }
              ]
            }
          }
        },
        {
          "name": "keyword.operator.arrow.rizolang",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.rizolang",
          "match": "!=|<=|>=|<|>|="
        },
        {
          "name": "entity.name.type.model.rizolang",
          "match": "\\b[A-Z][A-Za-z0-9]*\\b"
        },
        {
          "name": "punctuation.section.block.rizolang",
          "match": "[{}]"
        }
      ]
    }
  }
}