{
  "name": "rizo",
  "displayName": "Rizo",
  "description": "BYOK AI coding assistant — cost-optimized model routing, file edit, terminal, git, all through your own OpenRouter key.",
  "version": "0.4.3",
  "publisher": "ChaitanyaAggarwal",
  "icon": "icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaitanyaaggarwal9/rizo-bot.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/chaitanyaaggarwal9/rizo-bot/issues"
  },
  "homepage": "https://github.com/chaitanyaaggarwal9/rizo-bot/blob/main/vscode-extension/ONBOARDING.md",
  "keywords": [
    "ai",
    "chat",
    "assistant",
    "openrouter",
    "byok",
    "coding assistant"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rizo.openChat",
        "title": "Rizo: Open Chat"
      },
      {
        "command": "rizo.changeApiKey",
        "title": "Rizo: Change OpenRouter API Key"
      },
      {
        "command": "rizo.reopenClosedSession",
        "title": "Rizo: Reopen Closed Session"
      },
      {
        "command": "rizo.addFileToThread",
        "title": "Add File to Rizo Thread"
      },
      {
        "command": "rizo.implementTodo",
        "title": "Implement with Rizo"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rizo.addFileToThread",
          "group": "rizo",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "editor/title/context": [
        {
          "command": "rizo.addFileToThread",
          "group": "rizo"
        }
      ],
      "commandPalette": [
        {
          "command": "rizo.addFileToThread",
          "when": "false"
        },
        {
          "command": "rizo.implementTodo",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Rizo",
      "properties": {
        "rizo.permissions.autoApproveCommandPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Regex patterns tested against the full `run_command` string. A match skips the approval dialog entirely. **Has no effect on destructive commands** (force-push, `reset --hard`, `branch -D`, `rm -rf`, etc.) — those always ask, regardless of this setting."
        },
        "rizo.permissions.disabledTools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read_file",
              "write_file",
              "edit_file",
              "run_command"
            ]
          },
          "default": [],
          "description": "Tools listed here are refused outright and not offered to the model at all in this workspace."
        },
        "rizo.composer.sendKey": {
          "type": "string",
          "enum": [
            "enter",
            "ctrlEnter"
          ],
          "enumDescriptions": [
            "Enter sends, Shift+Enter for a new line",
            "Ctrl/Cmd+Enter sends, Enter alone makes a new line"
          ],
          "default": "enter",
          "description": "Which key sends a message from the composer."
        },
        "rizo.view.focusMode": {
          "type": "boolean",
          "default": false,
          "description": "Hide tool-call activity in the chat, showing only your prompts and the final answers."
        },
        "rizo.todoCodeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show an \"Implement with Rizo\" CodeLens above TODO/FIXME comments."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
